{
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-staging-sql-server;Database=PortfolioEnterpriseStaging;User Id=staging-user;Password=staging-password;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=true;Connection Timeout=60"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-staging-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
