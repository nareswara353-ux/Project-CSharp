{
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-production-sql-server;Database=PortfolioEnterpriseProd;User Id=prod-user;Password=prod-password;TrustServerCertificate=False;Encrypt=True;MultipleActiveResultSets=true;Connection Timeout=120"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-prod-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
