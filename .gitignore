## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
.vscode/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# Publishing
*.pubxml
*.publishproj

# Others
*.pfx
*.pdb
*.cache
*.tmp
*.log
*.txt

# Environment files
.env
appsettings.Production.json
appsettings.Staging.json

# User secrets
secrets.json
secrets.*.json

# Test results
TestResults/
*.coverage
*.coveragexml
*.trx

# Coverage
coverage/
*.coverlet.*
*.dotCover

# Logs
logs/
*.log

# Temp files
*.tmp
temp/

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Mac
.DS_Store
*.AppleDouble
*.LSOverride

# Linux
*~
.*.swp
.*.swo

# Docker
*.dockerignore
!/.dockerignore

# Tools
*.ncrunch*
*.orig
*.crunch
*.vshost.*
